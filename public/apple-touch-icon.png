<svg width="180" height="180" viewBox="0 0 180 180" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Círculo de fondo con gradiente -->
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6366f1;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#4f46e5;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Círculo principal con esquinas redondeadas para Apple -->
  <rect x="10" y="10" width="160" height="160" rx="32" ry="32" fill="url(#bgGradient)" stroke="#1e1b4b" stroke-width="4"/>
  
  <!-- Letras HC -->
  <text x="90" y="110" font-family="Arial, sans-serif" font-weight="bold" font-size="60" fill="white" text-anchor="middle" dominant-baseline="middle">HC</text>
</svg> 